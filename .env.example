MAX_BOT_TOKEN=
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
ADMIN_CHANNEL_ID=
WEBHOOK_PATH=/webhook
WEBHOOK_URL=https://support.krivoshein.site/webhook
# Секрет webhook (5–256 символов: A-Z, a-z, 0-9, _, -). MAX шлёт его в X-Max-Bot-Api-Secret.
WEBHOOK_SECRET=

# --- LLM (Groq) ---
# По умолчанию выключено. Включать только после smoke-теста.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=10.0
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3
LLM_RATE_LIMIT_PER_HOUR=8
LLM_HISTORY_PAIRS=5
LLM_HISTORY_TTL_HOURS=24
# --- Web AI Popup Assistant ---
WEB_ASSISTANT_ENABLED=true
WEB_CORS_ORIGINS=https://bots.krivoshein.site,https://wordpress.krivoshein.site,https://vps.krivoshein.site,https://direct.krivoshein.site,https://landing.krivoshein.site,https://ai-ready.krivoshein.site,https://krivoshein.site,https://www.krivoshein.site,https://support.krivoshein.site,https://drslon.ru,https://a-krivoshen.github.io
WEB_RATE_LIMIT_PER_HOUR=30
WEB_HUB_LLMS_PATH=/var/www/krivoshein.site/htdocs/llms.txt
WEB_SITES_ROOT=/var/www
WEB_KNOWLEDGE_TTL_SECONDS=600
